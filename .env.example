# 运行模式：mock（离线模拟裁判，无需 Key）/ real（调用真实 LLM 裁判）
EVAL_MODE=mock

# 真实模式配置：任何兼容 OpenAI Chat Completions 协议的服务都可以
# DeepSeek:  https://api.deepseek.com/v1          模型 deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 智谱:      https://open.bigmodel.cn/api/paas/v4  模型 glm-4-plus
EVAL_MODEL=deepseek-chat
EVAL_API_KEY=
EVAL_BASE_URL=https://api.deepseek.com/v1
EVAL_TEMPERATURE=0
EVAL_JSON_MODE=true
EVAL_MAX_RETRIES=2
